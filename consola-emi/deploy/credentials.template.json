{
  "version": 1,
  "variables": [
    { "key": "N8N_WEBHOOK_SECRET", "value": "", "secret": true, "runtime": true, "build": false }
  ],
  "connections": [
    {
      "name": "emi-n8n",
      "baseUrl": "https://N8N_HOST_POR_DEFINIR",
      "authHeader": "X-Emi-Secret",
      "authValue": "${N8N_WEBHOOK_SECRET}",
      "allowedMethods": ["POST"]
    }
  ],
  "database": {
    "tables": [
      { "name": "faqs", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "base_id", "type": "INT" },
        { "name": "pregunta", "type": "VARCHAR(500)" },
        { "name": "respuesta", "type": "TEXT" },
        { "name": "categoria", "type": "VARCHAR(60)" },
        { "name": "keywords", "type": "TEXT" },
        { "name": "fuente", "type": "VARCHAR(120)" },
        { "name": "activa", "type": "BOOLEAN" },
        { "name": "version", "type": "INT" },
        { "name": "updated_at", "type": "DATETIME" }
      ]},
      { "name": "faq_versions", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "faq_id", "type": "INT" },
        { "name": "version", "type": "INT" },
        { "name": "snapshot", "type": "TEXT" },
        { "name": "changed_at", "type": "DATETIME" }
      ]},
      { "name": "config", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "version", "type": "INT" },
        { "name": "payload", "type": "TEXT" },
        { "name": "changed_at", "type": "DATETIME" }
      ]},
      { "name": "conversations", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "channel", "type": "VARCHAR(20)" },
        { "name": "mode", "type": "VARCHAR(10)" },
        { "name": "client_ref_masked", "type": "VARCHAR(40)" },
        { "name": "escalated", "type": "BOOLEAN" },
        { "name": "escalation_reason", "type": "VARCHAR(40)" },
        { "name": "ticket_id", "type": "VARCHAR(40)" },
        { "name": "started_at", "type": "DATETIME" },
        { "name": "last_at", "type": "DATETIME" }
      ]},
      { "name": "messages", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "conversation_id", "type": "INT" },
        { "name": "role", "type": "VARCHAR(10)" },
        { "name": "text", "type": "TEXT" },
        { "name": "intent", "type": "VARCHAR(60)" },
        { "name": "tipo", "type": "VARCHAR(20)" },
        { "name": "faq_id", "type": "INT" },
        { "name": "categoria", "type": "VARCHAR(60)" },
        { "name": "confidence", "type": "DECIMAL(4,3)" },
        { "name": "latency_ms", "type": "INT" },
        { "name": "created_at", "type": "DATETIME" }
      ]},
      { "name": "gaps", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "pregunta", "type": "TEXT" },
        { "name": "score", "type": "DECIMAL(4,3)" },
        { "name": "faq_sugerida", "type": "INT" },
        { "name": "estado", "type": "VARCHAR(20)" },
        { "name": "faq_id", "type": "INT" },
        { "name": "conversation_id", "type": "INT" },
        { "name": "created_at", "type": "DATETIME" }
      ]},
      { "name": "feedback", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "message_id", "type": "INT" },
        { "name": "util", "type": "BOOLEAN" },
        { "name": "comentario", "type": "TEXT" },
        { "name": "created_at", "type": "DATETIME" }
      ]},
      { "name": "documents", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "nombre", "type": "VARCHAR(255)" },
        { "name": "tipo", "type": "VARCHAR(10)" },
        { "name": "estado", "type": "VARCHAR(20)" },
        { "name": "draft_faqs", "type": "TEXT" },
        { "name": "faqs_incorporadas", "type": "INT" },
        { "name": "created_at", "type": "DATETIME" }
      ]},
      { "name": "audit_log", "ownerScoped": true, "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "owner_email", "type": "VARCHAR(255)", "nullable": false },
        { "name": "accion", "type": "VARCHAR(60)" },
        { "name": "objeto", "type": "VARCHAR(60)" },
        { "name": "resultado", "type": "VARCHAR(20)" },
        { "name": "detalle", "type": "TEXT" },
        { "name": "created_at", "type": "DATETIME" }
      ]},
      { "name": "holidays", "columns": [
        { "name": "id", "type": "INT", "primaryKey": true, "autoIncrement": true },
        { "name": "fecha", "type": "VARCHAR(10)", "unique": true },
        { "name": "nombre", "type": "VARCHAR(120)" }
      ]}
    ]
  }
}
