# Copia este archivo como .env y completa los valores marcados con <>.
# Fija la versión estable vigente (ver https://github.com/EvolutionAPI/evolution-api/releases), ej. evoapicloud/evolution-api:v2.x.y
EVOLUTION_IMAGE=evoapicloud/evolution-api:latest

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=<https://evolution.plataform.com>
LANGUAGE=es
CORS_ORIGIN=*

# Clave global de la API (genérala con: openssl rand -hex 32). Va en la credencial de n8n "Evolution · API key (apikey)".
AUTHENTICATION_API_KEY=<clave-global>

POSTGRES_PASSWORD=<contraseña-postgres>
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:<contraseña-postgres>@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
# Privacidad: el histórico vive en HubSpot; Evolution no guarda mensajes, chats ni contactos.
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=Emi Mesfix
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false
WEBHOOK_GLOBAL_ENABLED=false
LOG_LEVEL=ERROR,WARN,INFO
