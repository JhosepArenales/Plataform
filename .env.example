# ─── Claude ────────────────────────────────────────────────────────────────
# Clave de la API de Anthropic (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# ─── Asana (opcional) ──────────────────────────────────────────────────────
# Token personal de acceso: Asana > Configuración > Apps > Tokens de acceso personal
ASANA_TOKEN=
# GID del workspace. Si lo dejas vacío, `npm run agente -- doctor` te lo muestra.
ASANA_WORKSPACE_GID=

# ─── Jira Cloud (opcional) ─────────────────────────────────────────────────
# Solo el subdominio: para https://miempresa.atlassian.net usa "miempresa"
JIRA_SITE=
JIRA_EMAIL=
# Token de API: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# ─── Comportamiento ────────────────────────────────────────────────────────
# Modelo a usar (por defecto claude-opus-5)
AGENTE_MODELO=claude-opus-5
