# Puerto HTTP
PORT=3000
# Carpeta para la base de datos SQLite y los videos subidos (usar un volumen persistente en producción)
DATA_DIR=./data
# Clave de la API de Claude para generar/actualizar cursos con IA (sin ella se usa el modo básico)
ANTHROPIC_API_KEY=
# Modelo (opcional)
ANTHROPIC_MODEL=claude-opus-5-5
# Correos con rol administrador, separados por coma (el primer usuario registrado también es admin)
ADMIN_EMAILS=
# Restringe el ingreso a un dominio de correo, p. ej. plataform.com
ALLOWED_EMAIL_DOMAIN=
# Tamaño máximo de video en MB
MAX_VIDEO_MB=1024
