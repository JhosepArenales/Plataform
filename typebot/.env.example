# Generar con: openssl rand -base64 32
ENCRYPTION_SECRET=

DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot

NODE_OPTIONS=--no-node-snapshot

# URL pública donde quedará el builder (editor de flujos), ej: https://bot.tuempresa.com
NEXTAUTH_URL=
# URL pública donde quedará el viewer (el chat que ve el usuario final)
NEXT_PUBLIC_VIEWER_URL=

# Requerido si se usan bloques de Webhook. Generar otro secreto aleatorio
# (mínimo 32 caracteres), independiente del de arriba.
# WEBHOOK_RELAY_SECRET=

# Email con el que vas a iniciar sesión como administrador del builder
ADMIN_EMAIL=
