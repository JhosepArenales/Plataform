{
  "name": "Agente de diagnóstico",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "diagnostico",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 400],
      "webhookId": "agente-diagnostico"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst question = body.question ?? body.pregunta ?? '';\nconst sessionId = body.sessionId ?? $execution.id;\nreturn [{ json: { question, sessionId } }];"
      },
      "id": "build-prompt",
      "name": "Construir prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemMessage": "Eres un asistente que responde preguntas usando la herramienta \"consultar_documento\" para leer la base de conocimiento de la empresa antes de responder. Si la respuesta no está en el documento, dilo claramente en vez de inventarla. Responde en español, de forma clara y directa."
        }
      },
      "id": "ai-agent",
      "name": "Agente de IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [720, 400]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash"
      },
      "id": "gemini-chat-model",
      "name": "Modelo de chat Géminis de Google",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [640, 640],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Construir prompt').item.json.sessionId }}",
        "contextWindowLength": 10
      },
      "id": "memory",
      "name": "Memoria",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [780, 640]
    },
    {
      "parameters": {
        "name": "consultar_documento",
        "description": "Devuelve el contenido completo del documento de la empresa (base de conocimiento). Úsala siempre antes de responder preguntas sobre políticas, procesos o información interna.",
        "method": "GET",
        "url": "=https://docs.googleapis.com/v1/documents/{{$env.GOOGLE_DOC_ID}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {}
      },
      "id": "doc-tool",
      "name": "Herramienta",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [920, 640],
      "credentials": {
        "googleApi": {
          "id": "",
          "name": "Google Service Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output ?? 'No se pudo generar una respuesta.';\nreturn [{ json: { answer: output } }];"
      },
      "id": "process-response",
      "name": "Procesar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": $json.answer } }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respondedor OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1220, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Construir prompt", "type": "main", "index": 0 }]]
    },
    "Construir prompt": {
      "main": [[{ "node": "Agente de IA", "type": "main", "index": 0 }]]
    },
    "Agente de IA": {
      "main": [[{ "node": "Procesar respuesta", "type": "main", "index": 0 }]]
    },
    "Procesar respuesta": {
      "main": [[{ "node": "Respondedor OK", "type": "main", "index": 0 }]]
    },
    "Modelo de chat Géminis de Google": {
      "ai_languageModel": [[{ "node": "Agente de IA", "type": "ai_languageModel", "index": 0 }]]
    },
    "Memoria": {
      "ai_memory": [[{ "node": "Agente de IA", "type": "ai_memory", "index": 0 }]]
    },
    "Herramienta": {
      "ai_tool": [[{ "node": "Agente de IA", "type": "ai_tool", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
