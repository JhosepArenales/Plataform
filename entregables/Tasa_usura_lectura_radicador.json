    {
      "parameters": {
        "jsCode": "// Lee la hoja SPREAD (B1 = \"noviembre 2026\", B2 = tasa de usura). El tope Plataform = usura - 0,05 (política interna).\nconst v = ($input.first().json.values || []);\nconst MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];\nconst textoMes = String((v[0] || [])[1] || '').trim().toLowerCase();\nconst m = textoMes.match(/([a-záéíóú]+)\\s+(\\d{4})/);\nconst idx = m ? MESES.indexOf(m[1]) : -1;\nconst mes = idx >= 0 ? m[2] + '-' + String(idx + 1).padStart(2, '0') : null;\nconst num = t => { const s = String(t == null ? '' : t).replace('%', '').trim().replace(',', '.'); const n = parseFloat(s); return isFinite(n) ? n : null; };\nconst usura = num((v[1] || [])[1]);\nreturn [{ json: {\n  mes, usuraEA: usura, topeEA: usura == null ? null : Math.round((usura - 0.05) * 100) / 100,\n  textoMes, fuente: 'Hoja SPREAD (1hNZgqrJPhIEcKd4RaJh0VMlpia-N2ns0XVLmQPiXIG8)'\n} }];"
      },
